{
    "$schema": "https://json.schemastore.org/package.json",
    "name": "docker-practice",
    "version": "1.0.0",
    "main": "dist/app.js",
    "type": "module",
    "scripts": {
        "dev": "tsx watch src/app.ts",
        "build": "pnpm lint && tsc && tsc -p tsconfig.build.json && tsc-alias -p tsconfig.build.json",
        "start": "node dist/app.js",
        "lint": "pnpm oxlint .",
        "worker:email": "tsx watch src/workers/processes/email.ts",
        "worker:push": "tsx watch src/workers/processes/push.ts",
        "db:generate": "pnpm dlx prisma generate",
        "db:migrate": "pnpm dlx prisma migrate dev",
        "db:migrate-deploy": "pnpm dlx prisma migrate deploy",
        "db:create-migration": "pnpm dlx prisma migrate dev --create-only",
        "db:status": "pnpm dlx prisma migrate status",
        "db:studio": "pnpm dlx prisma studio",
        "db:seed": "tsx prisma/seed.ts",
        "prod": "pnpm dlx pm2-runtime start ecosystem.config.cjs",
        "monitor": "pnpm dlx pm2 monit"
    },
    "author": "satin",
    "license": "ISC",
    "description": "docker practice",
    "dependencies": {
        "@fastify/autoload": "^6.5.0",
        "@fastify/cors": "^11.3.0",
        "@fastify/env": "^7.0.0",
        "@fastify/helmet": "^13.1.1",
        "@fastify/rate-limit": "^11.2.0",
        "@fastify/redis": "^9.0.0",
        "@fastify/sensible": "^6.0.5",
        "@fastify/swagger": "^9.8.1",
        "@fastify/swagger-ui": "^6.1.1",
        "@prisma/adapter-pg": "^7.9.1",
        "@prisma/client": "^7.9.1",
        "@zrosenbauer/fastify-prisma": "^7.0.2",
        "bullmq": "^6.1.2",
        "fastify": "^5.12.1",
        "fastify-cli": "^8.0.0",
        "fastify-plugin": "^6.0.0",
        "fastify-type-provider-zod": "^7.0.0",
        "ioredis": "^6.0.0",
        "pg": "^8.23.0",
        "pino": "^10.3.1",
        "pm2": "^7.0.3",
        "zod": "^4.4.3"
    },
    "devDependencies": {
        "@trivago/prettier-plugin-sort-imports": "^6.0.2",
        "@types/node": "^26.2.0",
        "@types/pg": "^8.23.1",
        "oxlint": "^1.79.0",
        "pino-pretty": "^13.1.3",
        "prettier": "^3.9.6",
        "prisma": "^7.9.1",
        "prisma-zod-generator": "^3.3.0",
        "tsc-alias": "^1.9.2",
        "tsx": "^4.23.12",
        "typescript": "^7.0.2"
    }
}
